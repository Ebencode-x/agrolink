 templates/auth/login.html                | 2 --
 templates/base.html                      | 1 -
 templates/dashboard/dashboard.html       | 2 --
 templates/developer.html                 | 5 -----
 templates/index.html                     | 9 ---------
 templates/market/ai_daktari.html         | 5 -----
 templates/market/price_intelligence.html | 5 -----
 8 files changed, 32 deletions(-)

